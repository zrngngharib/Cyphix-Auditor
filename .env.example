# =============================================================================
# Quantix 7-Dimensional Codebase & Cybersecurity Auditor - Environment Config
# =============================================================================
# Copy this file to '.env.local' and fill in your preferred API keys.
# All keys are optional: You can also enter them directly in the Web UI.

# -----------------------------------------------------------------------------
# 1. Google Gemini (Recommended for massive repositories & ultra-fast audits)
# Get your free API key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. Anthropic Claude (Best for deep architectural & complex security audits)
# Get your API key at: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# 3. DeepSeek Cloud (Cost-effective & advanced mathematical reasoning)
# Get your API key at: https://platform.deepseek.com/
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# -----------------------------------------------------------------------------
# 4. Local Offline Model Configuration (Optional)
# Default search path is ./models/*.gguf (Auto-discovered by Quantix)
# -----------------------------------------------------------------------------
# LOCAL_MODEL_PATH=./models/qwen-coder-7b.gguf
